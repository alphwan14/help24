# =============================================================================
# Help24 Backend (NestJS) — environment template
# =============================================================================
# Copy to `.env` and fill in real values. NEVER commit `.env` — only this
# `.env.example` belongs in git. On Render, set these as dashboard env vars
# (no file is uploaded); this file documents exactly what the service needs.
#
# NOTE ON NAMES: variable names below match what the code actually reads
# (see backend/src/config/configuration.ts). The M-Pesa / Daraja keys are
# prefixed MPESA_ (not DARAJA_), and there is NO JWT_SECRET — admin auth uses
# hashed opaque tokens, not JWTs. Do not rename these or the server will fail
# its startup config validation.
#
# DOCKER: this is the ONE file the `api` container reads (docker-compose.yml
# loads it via `env_file:`). The same file serves `npm run start:dev`, so the
# native and containerised workflows can never drift. Nothing here is ever
# copied into an image — `.env` is excluded by backend/.dockerignore and
# injected at runtime instead. Infrastructure knobs (ports, local Postgres and
# Redis credentials) live in `docker.env` at the repo root, not here.
# =============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# Comma-separated list of allowed browser origins for CORS. Leave UNSET to allow
# all origins (current default). In production, restrict to the dashboard origin:
#   CORS_ORIGINS=https://help24-admin-dashboard.vercel.app
CORS_ORIGINS=


# ── Redis — distributed rate limiting ─────────────────────────────────────────
# Parsed and validated at boot by src/redis/redis.config.ts.
#
# WHAT BREAKS WITHOUT IT: nothing visibly, and that is the danger. With no
# REDIS_URL the backend still starts and still enforces every limit — but the
# state lives in ONE process, so the ceiling silently becomes `limit x number
# of instances`. Run more than one replica without Redis and the limits stop
# meaning what the catalogue says they mean. The boot log says so in a banner,
# and GET /health/redis reports `degraded`.
#
# Docker Compose sets this automatically to the in-network service; you only
# need it here for the native workflow or a hosted Redis.
#   REDIS_URL=redis://:password@127.0.0.1:6379
#   REDIS_URL=rediss://default:password@managed-host:6380   (TLS)
REDIS_URL=

# Refuse to START when Redis cannot be reached, instead of degrading quietly.
# Leave false until a Redis instance actually exists; set true in production
# once it does, so a future misconfiguration fails the deploy rather than
# shipping weaker guarantees than intended.
REDIS_REQUIRED=false

# Prefix on every rate-limit key. Defaults to `help24:<NODE_ENV>`.
# MUST be distinct per deployment when two environments share one Redis —
# otherwise a staging load test consumes production users' budget.
# REDIS_KEY_PREFIX=help24:production

# How long a single Redis command may take before the limiter gives up and
# falls back to per-instance limits. Small on purpose: a rate-limit check that
# takes longer than this has already failed at its job, which is to be
# invisible. Default 250ms.
# REDIS_COMMAND_TIMEOUT_MS=250
# REDIS_CONNECT_TIMEOUT_MS=5000
# REDIS_MAX_RECONNECT_DELAY_MS=10000


# ── Structured logging ────────────────────────────────────────────────────────
# json    one object per line — for a log collector; search by requestId
# pretty  aligned and coloured — for a terminal
# Default: json when NODE_ENV=production, pretty otherwise.
# LOG_FORMAT=json

# verbose | debug | log | warn | error. Default `log` (debug/verbose are
# opt-in, so production does not pay to ship them).
# LOG_LEVEL=log

# Mask phone numbers in log output. Credentials and tokens are ALWAYS masked
# regardless of this setting — this switch only covers PII, and exists so a
# specific payment can be traced locally. Never set false in production.
# LOG_MASK_PII=true


# ── Health ────────────────────────────────────────────────────────────────────
# Table read by GET /health/database. Any small, always-present table works;
# the probe does `select id limit 1`, which is an index scan.
# HEALTH_DB_TABLE=posts

# ── Supabase ──────────────────────────────────────────────────────────────────
# service_role key — Settings → API → service_role. Server-side ONLY, full access.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Admin system ──────────────────────────────────────────────────────────────
# Origin of the admin DASHBOARD (Next.js frontend) — used to build invite links.
#   dev:  http://localhost:3001
#   prod: https://help24-admin-dashboard.vercel.app
ADMIN_DASHBOARD_URL=https://help24-admin-dashboard.vercel.app
# Verbose admin-auth logging + /admin/_diag endpoint. Keep false in production.
ADMIN_AUTH_DEBUG=false

# ── M-Pesa Daraja (STK push) ──────────────────────────────────────────────────
MPESA_ENV=production                                  # sandbox | production
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_SHORTCODE=your-shortcode                        # sandbox default: 174379
MPESA_PASSKEY=your-lipa-na-mpesa-passkey
# Callbacks MUST be HTTPS and contain the exact path (validated at startup).
MPESA_CALLBACK_URL=https://help24-backend.onrender.com/mpesa/stk-callback

# ── M-Pesa B2C (provider payouts) ─────────────────────────────────────────────
MPESA_B2C_INITIATOR_NAME=your-api-initiator-name
MPESA_B2C_SECURITY_CREDENTIAL=your-encrypted-security-credential
MPESA_B2C_RESULT_URL=https://help24-backend.onrender.com/mpesa/b2c-callback
MPESA_B2C_TIMEOUT_URL=https://help24-backend.onrender.com/mpesa/b2c-timeout

# ── M-Pesa dev simulation (OPTIONAL, non-production only) ─────────────────────
# `true` short-circuits Daraja and simulates a successful payment — no real STK
# push, no real money. mpesa.service.ts THROWS AT STARTUP if this is `true`
# while NODE_ENV=production, which is a deliberate hard block.
# The container image sets NODE_ENV=production by default, so to use this under
# Docker you must also set NODE_ENV=development in docker.env.
MPESA_DEV_FORCE_SUCCESS=false

# ── Google Routes (OPTIONAL — journey ETAs) ───────────────────────────────────
# Read by config/configuration.ts but deliberately NOT required: if unset, the
# /routes endpoint answers "unavailable" and the app falls back to straight-line
# distance. The server must never refuse to boot over this.
# Must be a SERVER key (no Android package/SHA-1 restriction). Restrict by IP.
# Never ship it in the mobile app.
GOOGLE_ROUTES_API_KEY=

# ── Firebase Admin (push notifications) ───────────────────────────────────────
# From the Firebase service-account JSON. Keep the private key's literal \n
# escapes intact (the code converts them back to newlines).
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Authentication enforcement (Priority 2) ───────────────────────────────────
# The migration control. THREE VALUES, IN ORDER — this is a sequence, not a
# preference, and moving between stages is an env change plus a restart, never
# a redeploy. Read backend/src/common/auth/auth.types.ts for the full reasoning.
#
#   off      Pre-migration behaviour. A request with no token is accepted and
#            its asserted identity is trusted. Nothing is measured.
#   monitor  DEFAULT when unset. Identical RESPONSES to `off`, so no shipped
#            client breaks — but every request enforcement WOULD reject is
#            recorded (access log: authWouldDeny), and a caller who DOES present
#            a valid token can no longer act as someone else.
#   enforce  Protected routes require a verified Firebase ID token. A body field
#            naming a different user is a 403.
#
# READINESS TEST before switching to `enforce`: count access-log entries with
# `authWouldDeny` set, grouped by route. It must be at (or near) zero, which
# means the updated client has reached the fleet. Rolling back is the same
# change in reverse.
AUTH_ENFORCEMENT=monitor

# Graduated rollout (OPTIONAL, and only valid when AUTH_ENFORCEMENT=enforce —
# setting it otherwise fails the boot rather than silently doing nothing).
# Comma-separated path prefixes or "METHOD /path" entries. When set, ONLY these
# routes are enforced and everything else stays in monitor behaviour. Use it to
# enforce the money paths first, where the risk is concentrated, without waiting
# for the long tail of app upgrades.
#   AUTH_ENFORCE_ONLY=/mpesa,/jobs,POST /reviews
AUTH_ENFORCE_ONLY=

# ── Verified-token cache (OPTIONAL) ───────────────────────────────────────────
# Verification is a local RSA signature check (~22 µs) against Google's cached
# signing keys — no network call in the steady state. The cache removes ~90% of
# even that for a polling client, which this one is (payment status every 5s,
# job status every 30s, telemetry every 8s, all on one hour-long token).
#
# It cannot admit a forged token: a forgery never verified, so it never entered
# the cache. Entry lifetime is capped at BOTH the TTL below and the token's own
# `exp`, whichever is shorter, so a cached identity can never outlive its
# credential. Keys are SHA-256 digests, never the tokens themselves.
AUTH_TOKEN_CACHE=true
AUTH_TOKEN_CACHE_MAX=10000
AUTH_TOKEN_CACHE_TTL_MS=300000
