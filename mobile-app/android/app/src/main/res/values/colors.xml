<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The launcher tile is the app's own paper, with the ink bars and amber
         pill on top: the icon promises the calm, light app that opens, not a
         dark one. Changed from Ink (#12161A) in 1.0.12. -->
    <color name="ic_launcher_background">#F5F3EF</color>

    <!-- Splash background in LIGHT mode: AppTheme.lightBackground, the field
         the first screen paints, so the handoff has no flash. The dark-mode
         value (brand Ink) lives in values-night/colors.xml, and both are
         mirrored by LaunchSplash in Dart. -->
    <color name="splash_background">#FAF9F7</color>

    <!-- Tints the white notification silhouette (drawable/ic_stat_help24). -->
    <color name="notification_accent">#E8A33D</color>
</resources>
