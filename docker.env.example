# =============================================================================
# Help24 — Docker infrastructure settings
# =============================================================================
# WHAT BELONGS HERE
#   Knobs for the LOCAL containers compose starts: image versions, host ports,
#   bind addresses, and the throwaway credentials for the local Postgres/Redis/
#   pgAdmin containers.
#
# WHAT DOES NOT BELONG HERE
#   Application secrets. SUPABASE_SERVICE_ROLE_KEY, MPESA_*, FIREBASE_* all live
#   in `backend/.env`, which the api service loads directly via `env_file:`.
#   Keeping the two apart means this file stays boring enough to reason about,
#   and the file with real secrets has exactly one consumer.
#
# HOW TO USE
#   1. cp docker.env.example docker.env      (docker.env is gitignored by *.env)
#   2. docker compose --env-file docker.env --profile full up -d
#
#   Every variable below already has the SAME default baked into
#   docker-compose.yml, so plain `docker compose up -d` works without this file.
#   You only need `--env-file docker.env` once you change something.
#
#   To avoid retyping the flag, set it once per shell:
#     PowerShell:  $env:COMPOSE_ENV_FILES = "docker.env"
#     bash/zsh:    export COMPOSE_ENV_FILES=docker.env
# =============================================================================


# ── API ───────────────────────────────────────────────────────────────────────

# Host port the backend is published on. Change if 3000 is taken; the port
# INSIDE the container is always 3000, so nothing needs rebuilding.
API_PORT=3000

# Which host interface to publish on.
#   0.0.0.0   — reachable from your LAN. Required to test on a PHYSICAL phone.
#   127.0.0.1 — this machine only. Use on public/untrusted Wi-Fi.
# The Android emulator reaches the host at 10.0.2.2 and works with either.
API_BIND=0.0.0.0

# `production` mirrors Render and is the correct default.
# Set to `development` ONLY when you need MPESA_DEV_FORCE_SUCCESS=true —
# mpesa.service.ts throws at boot if that flag is on while NODE_ENV=production.
NODE_ENV=production

# Base image for the backend build. Pin by digest for reproducible releases:
#   NODE_IMAGE=node:22-alpine@sha256:<digest>
NODE_IMAGE=node:22-alpine

# Tag applied to the built image (help24/backend:<tag>).
HELP24_TAG=local


# ── PostgreSQL   [profile: db] ────────────────────────────────────────────────
# Local development only. These are NOT production credentials — production is
# Supabase, and its credentials never appear in this repo.
#
# Reminder: the NestJS API cannot use this database. It speaks PostgREST, not
# the Postgres wire protocol. See DOCKER.md § Switching between Supabase and
# local Postgres.

POSTGRES_VERSION=16-alpine
POSTGRES_USER=help24
POSTGRES_PASSWORD=help24_local_dev
POSTGRES_DB=help24
POSTGRES_PORT=5432

# Loopback by default: a database on 0.0.0.0 is reachable by every device on
# the network you happen to be joined to.
POSTGRES_BIND=127.0.0.1


# ── Redis   [profile: cache] ──────────────────────────────────────────────────
# Prepared, not yet used by any application code.

REDIS_VERSION=7-alpine
REDIS_PASSWORD=help24_local_redis
REDIS_PORT=6379
REDIS_BIND=127.0.0.1

# Ceiling for the local instance. The eviction policy is pinned to `noeviction`
# in docker-compose.yml and should stay there — see the comment on that service
# before changing it, because an LRU policy silently drops queue jobs.
REDIS_MAXMEMORY=256mb


# ── pgAdmin   [profile: tools] ────────────────────────────────────────────────
# Runs in desktop mode (no login screen). That is only safe because it is bound
# to loopback. Do not publish this on a routable address.

PGADMIN_VERSION=8.14
PGADMIN_EMAIL=dev@help24.local
PGADMIN_PASSWORD=help24_local_dev
PGADMIN_PORT=5050
PGADMIN_BIND=127.0.0.1
